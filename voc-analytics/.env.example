# Database Configuration
DATABASE_URL=postgresql+asyncpg://vocuser:vocpassword@localhost:5432/vocdb

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_URL=amqp://vocuser:vocpassword@localhost:5672/

# Application Security
SECRET_KEY=your-secret-key-here-change-in-production
WEBHOOK_SECRET=your-webhook-secret-here-change-in-production

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=VoC Analytics System

# Environment
ENVIRONMENT=development
DEBUG=True

# Google Maps / SerpAPI Configuration (Optional)
# These can be set here or passed in API request body
SERPAPI_KEY=your_serpapi_key_here
GOOGLE_MAPS_DATA_ID=your_google_maps_data_id_here

# Facebook Webhook Configuration
# Required for Facebook Page webhook integration
# Get these from: https://developers.facebook.com/apps/

# REQUIRED: App Secret for webhook signature verification (X-Hub-Signature-256)
# Found in: App Dashboard > Settings > Basic > App Secret
FACEBOOK_APP_SECRET=your_facebook_app_secret

# REQUIRED: Custom verify token for webhook setup (you choose this value)
# Used during initial webhook verification
FACEBOOK_VERIFY_TOKEN=your_custom_verify_token_here

# REQUIRED: Page Access Token for Graph API calls
# Found in: App Dashboard > Messenger > Settings > Access Tokens
# Or generate via Graph API Explorer with pages_read_engagement, pages_manage_metadata permissions
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here

# OPTIONAL: App ID (not currently used but good to have)
FACEBOOK_APP_ID=your_facebook_app_id

# OPTIONAL: Graph API Version (default: v24.0)
FACEBOOK_GRAPH_API_VERSION=v24.0
