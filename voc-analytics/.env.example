# Database Configuration
DATABASE_URL=postgresql+asyncpg://vocuser:vocpassword@localhost:5432/vocdb

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration
RABBITMQ_URL=amqp://vocuser:vocpassword@localhost:5672/

# Application Security
SECRET_KEY=your-secret-key-here-change-in-production
WEBHOOK_SECRET=your-webhook-secret-here-change-in-production

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=VoC Analytics System

# Environment
ENVIRONMENT=development
DEBUG=True

# Google Maps / SerpAPI Configuration (Optional)
# These can be set here or passed in API request body
SERPAPI_KEY=your_serpapi_key_here
GOOGLE_MAPS_DATA_ID=your_google_maps_data_id_here
